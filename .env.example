# For docker compose. Copy to .env next to docker-compose.yml and fill in the keys. Never commit .env.

# OpenRouteService API key (routing, geocoding, POIs); required: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-openrouteservice-key
# Anthropic API key for the trip agent: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional; the values shown are the defaults
# Password for the bundled Postgres; change it for anything beyond your own machine
POSTGRES_PASSWORD=waypoint
# Port the app is served on: http://localhost:8080
WAYPOINT_PORT=8080
# Public deployment: makes trip and route writes agent-only (needs INTERNAL_API_SECRET)
PUBLIC_DEMO=false
# Any long random string; required when PUBLIC_DEMO=true
INTERNAL_API_SECRET=
# Agent turns per UTC day across all users
AGENT_DAILY_TURN_CAP=200
