# Copy to Frontend/.env.local for local development, or set these in your host's build settings
# (Vercel: Project Settings > Environment Variables). They're read at build time; rebuild after a change.
# Mock mode is the default when VITE_USE_MOCK is unset.

# true serves everything from src/fixtures; false talks to the FastAPI backend
VITE_USE_MOCK=true

# The backend's base URL in real mode, no trailing slash:
#   local:                http://localhost:8000
#   hosted (Render):      https://your-service.onrender.com
#   docker-compose nginx: /api
# The backend must allow this site's origin: add it to CORS_ORIGINS in the backend's settings
# (e.g. https://your-app.vercel.app). A backend that isn't on localhost may be asleep on free hosting;
# the app then shows "Waking up the server" while it boots instead of an error.
VITE_API_BASE=http://localhost:8000

# true when the backend runs with PUBLIC_DEMO=true: a route picked on the map is not saved directly
VITE_PUBLIC_DEMO=false
