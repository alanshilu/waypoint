# Copy to Backend/.env and fill in real values. Never commit .env.

# Postgres/PostGIS host
DB_HOST=localhost
# Postgres user
DB_USER=waypoint
# Postgres password
DB_PASS=change-me
# Postgres database name
DB_NAME=waypoint
# Optional Redis URL; not used yet (agent sessions are in memory), safe to leave unset
# REDIS_URL=redis://localhost:6379/0
# OpenRouteService API key (routing, geocoding, POIs): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-openrouteservice-key
# Anthropic API key for the trip agent and the eval judge: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional; the values shown are the defaults
# Claude model the agent runs on
AGENT_MODEL=claude-sonnet-5-5
# Agent reasoning effort: low, medium or high
AGENT_EFFORT=medium
# Claude model that judges reply length in the evals
EVAL_JUDGE_MODEL=claude-haiku-5-5
# Base URL the agent's tools call (this backend)
API_BASE_URL=http://localhost:8000
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Seconds to wait for one OpenRouteService directions request (fastest and backroads run in parallel)
ORS_ROUTE_TIMEOUT_S=90
# Seconds before POST /agent/message gives up on a turn
AGENT_TIMEOUT_S=180
# Agent messages allowed per session per minute
AGENT_RATE_LIMIT_PER_MINUTE=10
# Seconds an idle agent session is kept
AGENT_SESSION_TTL_S=1800
# Cost limits for a public demo (0 turns a limit off)
# Live agent sessions at once; more get a 503 "demo is busy"
AGENT_MAX_SESSIONS=200
# New agent sessions per client IP per hour; more get a 429
AGENT_SESSIONS_PER_IP_PER_HOUR=5
# Agent turns per UTC day across all users; more get a 429 "demo limit reached"
AGENT_DAILY_TURN_CAP=200
# User turns kept in a session's history
AGENT_HISTORY_MAX_TURNS=12

# Public deployment: true turns off GET /trips/trips and makes the trip and route write endpoints
# agent-only. Needs INTERNAL_API_SECRET. Set VITE_PUBLIC_DEMO=true in the frontend to match.
PUBLIC_DEMO=false
# Shared secret the agent's tools send in the X-Waypoint-Internal header; any long random string
# INTERNAL_API_SECRET=replace-with-a-long-random-string
