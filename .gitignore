# Secrets: only the .env.example files are committed
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Vite
node_modules/
dist/
.vite/

# Database dumps and local caches
backups/
*.dump
*.sqlite

# Eval runs: only the named summary reports (baseline.json, final.json) are committed
Backend/evals/reports/*
!Backend/evals/reports/baseline.json
!Backend/evals/reports/final.json

# OS / logs
*.log
.DS_Store
Thumbs.db
.neon

neon.ts
/package.json
/package-lock.json
.env.local
